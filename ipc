#!/usr/bin/env bash
# open-ipc's front door: the few things people do, one command each. Run with no arguments for the list.
# It finds ports and addresses by itself and calls the other scripts, which keep working on their own.
set -euo pipefail
cd "$(dirname "$0")"

STATE=${XDG_STATE_HOME:-$HOME/.local/state}/open-ipc
BASE_FILE=$STATE/base-address       # the base station's address, saved by "flash base"
BOARDS_FILE=$STATE/boards           # which board was flashed in which USB socket, for "log"

source ./wifi.sh                    # which WiFi adapter sends or receives, and which keys (shared with link.sh)

usage() {
  cat <<'END'
open-ipc: what do you want to do?

Set up the boards (once each):
  ./ipc flash camera N     a camera, N = 0, 1 or 2: plug it in when asked
  ./ipc flash base         the base station (ESP32-POE): plug it in when asked

Receive the cameras with the base station (up to 3 cameras, anywhere on the network):
  ./ipc view               every camera, live, in a browser
  ./ipc stream N URL       camera N to a video server (rtmp://...) with its telemetry burned in;
                           or a file name (cam0.mkv) to record, or nothing for a window

Or with this PC's own WiFi adapter (no base station):
  ./ipc receive            what the adapter hears, in a window: camera 0, or a PC running ./ipc send
  ./ipc receive URL        camera 0 to a video server (rtmp://...) with its telemetry burned in;
                           or a file name (cam0.mkv) to record

PC to PC:
  ./ipc send               this PC's webcam over its WiFi adapter (the other PC runs ./ipc receive)

Other:
  ./ipc keys               your own link keys instead of the shared test keys (then flash the boards again)
  ./ipc test               check the software on this PC (no boards needed)
  ./ipc log                what a board plugged into this PC is doing
  ./ipc setup              first time on a new PC: installs the tools

Add --port /dev/ttyUSBx to "flash" or "log" to name the port instead of plugging in.
END
}

say() { printf '%s\n' "$*"; }
die() { printf 'ipc: %s\n' "$*" >&2; exit 1; }

# The USB serial ports there are right now (looked up each time: boards come and go).
ports_now() {
  local p
  for p in /dev/ttyUSB* /dev/ttyACM*; do [[ -e $p ]] && printf '%s\n' "$p"; done
  return 0
}

# The USB socket a port's adapter is plugged into: stays the same when the port's name changes.
usb_socket() {
  udevadm info -q property -n "$1" 2>/dev/null | grep -oP '^ID_PATH=\K.*' || true
}

remember_board() {
  local socket
  socket=$(usb_socket "$1")
  [[ -n $socket ]] || return 0
  { grep -v "^$socket " "$BOARDS_FILE" 2>/dev/null || true; printf '%s %s\n' "$socket" "$2"; } >"$BOARDS_FILE.new"
  mv "$BOARDS_FILE.new" "$BOARDS_FILE"
}

board_name() {
  local socket
  socket=$(usb_socket "$1")
  [[ -n $socket && -f $BOARDS_FILE ]] && grep "^$socket " "$BOARDS_FILE" | cut -d' ' -f2- || true
}

# Waits for a USB serial port that wasn't there before, and prints it.
wait_for_new_port() {
  local what=$1 before now p
  before=$(ports_now)
  say "Plug $what into this PC now (USB data cable; a charge-only cable shows nothing)." >&2
  if [[ -n $before ]]; then
    say "  (already plugged in? Unplug it and plug it back in, or use --port.)" >&2
  fi
  for _ in $(seq 1 240); do
    now=$(ports_now)
    for p in $now; do
      if ! grep -qx "$p" <<<"$before"; then
        sleep 1  # let the port settle
        say "  found it on $p" >&2
        printf '%s\n' "$p"
        return 0
      fi
    done
    before=$now  # one unplugged meanwhile: its return counts as new
    sleep 0.5
  done
  die "no new USB serial port within 2 minutes. Ports now: $(ports_now | tr '\n' ' ')"
}

# The board's boot log for a few seconds (connecting restarts it).
boot_log() {
  timeout "$2" esp32/idf.sh python3 esp32/monitor.py "$1" 2>/dev/null | tr -d '\r' || true
}

# This PC's address on the LAN: where the base station should send telemetry.
pc_address() {
  ip -4 route get 1.1.1.1 2>/dev/null | grep -oP 'src \K[0-9.]+' | head -1
}

base_address() {
  if [[ -n ${BASE:-} ]]; then
    printf '%s\n' "$BASE"
  elif [[ -s $BASE_FILE ]]; then
    cat "$BASE_FILE"
  else
    die "I don't know the base station's address yet. Run ./ipc flash base, or give it: BASE=192.168.1.x ./ipc $*"
  fi
}

flash_camera() {
  local n=$1 port=$2 log
  [[ $n =~ ^[012]$ ]] || die "camera number must be 0, 1 or 2"
  [[ -n $port ]] || port=$(wait_for_new_port "camera $n (the ESP32-CAM on its USB board)")
  say "Building and flashing camera $n on $port (the first build takes a few minutes)..."
  CAM=$n ESPPORT=$port esp32/build.sh camera flash >"$STATE/flash.log" 2>&1 ||
    die "flashing failed; the details are in $STATE/flash.log"
  remember_board "$port" "camera $n"
  say "  $(key_status)"
  say "Checking that it sends video..."
  log=$(boot_log "$port" 15)
  if grep -q "wfb-ng link .* port $n," <<<"$log" && grep -qE 'video: [1-9][0-9]* fps' <<<"$log"; then
    say "  $(grep -oE 'video: [0-9]+ fps, [0-9]+ KB/frame' <<<"$log" | tail -1)"
    say "Done: camera $n is sending. Unplug it and power it from any USB charger."
  elif grep -q "wfb-ng link .* port $n," <<<"$log"; then
    say "Flashed as camera $n, but no video yet: is the camera module seated? Watch it with ./ipc log --port $port"
  else
    say "Flashed, but I couldn't see it start. Watch it with: ./ipc log --port $port"
  fi
}

flash_base() {
  local port=$1 to log addr
  to=${SEND_TO:-$(pc_address)}
  [[ -n $to ]] || die "can't tell this PC's LAN address; give it: SEND_TO=192.168.1.x ./ipc flash base"
  [[ -n $port ]] || port=$(wait_for_new_port "the base station (ESP32-POE)")

  # Telemetry (and camera 0's video for receiver.sh) goes to this PC: a build-time setting (menuconfig, R8)
  # in the local base/sdkconfig, which a first build creates.
  [[ -f esp32/base/sdkconfig ]] || esp32/build.sh base reconfigure >"$STATE/flash.log" 2>&1 ||
    die "setting up the base build failed; the details are in $STATE/flash.log"
  sed -i "s/^CONFIG_BASE_OUT_HOST=.*/CONFIG_BASE_OUT_HOST=\"$to\"/" esp32/base/sdkconfig

  say "Building and flashing the base station on $port (the first build takes a few minutes)..."
  ESPPORT=$port esp32/build.sh base flash >"$STATE/flash.log" 2>&1 ||
    die "flashing failed; the details are in $STATE/flash.log"
  remember_board "$port" "base station"
  say "  $(key_status)"
  say "Checking that it starts..."
  log=$(boot_log "$port" 25)
  addr=$(grep -oP 'eth: address \K[0-9.]+' <<<"$log" | tail -1 || true)
  if [[ -z $addr ]]; then
    say "Flashed, but it got no network address: is the Ethernet cable in? Watch it with: ./ipc log --port $port"
    return
  fi
  printf '%s\n' "$addr" >"$BASE_FILE"
  say "Done: the base station is at $addr."
  say "  web page:  http://$addr/          (./ipc view)"
  say "  RTSP:      rtsp://$addr:8554/cam0 ... cam2"
  say "  telemetry: to this PC ($to), UDP 5610-5612"
  open_firewall "$addr"
  grep -oE 'cam[0-2]: [0-9]+ frames \(rssi -?[0-9]+\)' <<<"$log" | sort -u -k1,1 | sed 's/^/  hears /' || true
}

pick_port() {
  local ports
  mapfile -t ports < <(ports_now)
  case ${#ports[@]} in
    0) die "no board plugged into this PC" ;;
    1) printf '%s\n' "${ports[0]}" ;;
    *)
      say "More than one board is plugged in:" >&2
      local i
      for i in "${!ports[@]}"; do say "  $((i + 1))) ${ports[$i]}  $(board_name "${ports[$i]}")" >&2; done
      read -rp "Which one? " i
      [[ $i =~ ^[0-9]+$ && $i -ge 1 && $i -le ${#ports[@]} ]] || die "no such board"
      printf '%s\n' "${ports[$((i - 1))]}" ;;
  esac
}

# Which keys the boards and the link use, in a few words.
key_status() {
  if [[ $(key_file gs.key) == */own/* ]]; then
    echo "keys: your own (keys/own)"
  else
    echo "keys: the shared test keys: anyone with this repo can watch (./ipc keys makes your own)"
  fi
}

# The base station's telemetry and video reach this PC only if its firewall lets them in.
open_firewall() {
  local addr=$1 ok
  command -v ufw >/dev/null && systemctl is-active -q ufw 2>/dev/null || return 0
  local rule="sudo ufw allow from $addr to any port 5600:5612 proto udp"
  if [[ -t 0 ]]; then
    read -rp "  Let the base station's telemetry through this PC's firewall? It asks for your password. [Y/n] " ok
    if [[ $ok != [nN]* ]]; then
      $rule >/dev/null && say "  firewall: open for $addr" && return 0
    fi
  fi
  say "  To let it through this PC's firewall later: $rule"
}

# The WiFi adapter for a role (rx or tx): TX_IF/RX_IF if set, else the best one here (wifi.sh). Warns, and
# asks, when it's this PC's network connection: monitor mode takes it over until Ctrl-C.
adapter_for() {
  local role=$1 iface ok named=RX_IF
  [[ $role == tx ]] && named=TX_IF
  iface=${!named:-$(wifi_pick "$role")}
  [[ -n $iface ]] || die "$(wifi_none "$role")"
  [[ -e /sys/class/net/$iface ]] || die "no WiFi interface $iface"
  say "Using $iface ($(wifi_driver "$iface")); another one: $named=<interface> ./ipc ..." >&2
  if wifi_in_use "$iface"; then
    say "  $iface is this PC's network connection right now: it is off that network until you stop." >&2
    if [[ -t 0 ]]; then
      read -rp "  Go ahead? [y/N] " ok
      [[ $ok == [yY]* ]] || exit 1
    fi
  fi
  printf '%s\n' "$iface"
}

# What this PC's own adapter hears, no base station: link.sh rx and a window (rx.sh, which tells camera
# JPEG from webcam H.264 by itself), or camera 0 with its telemetry burned in, to a server or a file.
receive() {
  local out=$1 iface
  iface=$(adapter_for rx)
  say "$(key_status)"
  say "It asks for your password: the adapter is switched to monitor mode. Ctrl-C stops."
  if [[ -z $out ]]; then
    RX_IF=$iface VIDEO=auto exec ./rx.sh
  fi
  ./build.sh
  sudo -v
  while sleep 60; do sudo -n -v; done &
  RECEIVE_KEEPALIVE=$!
  RECEIVE_LINK=""
  trap stop_receive EXIT
  trap 'exit 130' INT TERM
  sudo env RX_IF="$iface" ./link.sh rx &
  RECEIVE_LINK=$!
  sleep 2
  ./burnin.sh "$out" || true
}

stop_receive() {
  trap '' INT TERM
  sudo pkill -TERM -f '[l]ink.sh rx' || true  # [l] keeps pkill from matching its own sudo
  if [[ -n ${RECEIVE_LINK:-} ]]; then wait "$RECEIVE_LINK" 2>/dev/null || true; fi
  kill "${RECEIVE_KEEPALIVE:-}" 2>/dev/null || true
}

# This PC's webcam (a test pattern if it has none) over its own adapter: tx.sh.
send() {
  local iface source=webcam
  iface=$(adapter_for tx)
  if [[ ! -e ${DEVICE:-/dev/video0} ]]; then
    say "No webcam (${DEVICE:-/dev/video0}): sending a test pattern."
    source=test
  fi
  say "$(key_status)"
  say "It asks for your password: the adapter is switched to monitor mode. On the other PC: ./ipc receive. Ctrl-C stops."
  TX_IF=$iface SOURCE=$source exec ./tx.sh
}

# Your own key pair in keys/own/ (never committed, R9): the boards get it when flashed next, link.sh at once.
keys() {
  local own=keys/own password ok
  if [[ ${1:-} == reset ]]; then
    rm -rf "$own"
    say "Back to the shared test keys. Flash every board again (./ipc flash ...) so they match."
    return
  fi
  if [[ -d $own ]]; then
    if [[ -t 0 ]]; then
      read -rp "You already have your own keys; boards flashed with them stop working with new ones. Replace them? [y/N] " ok
      [[ $ok == [yY]* ]] || exit 1
    else
      die "you already have your own keys in $own; ./ipc keys reset first to replace them"
    fi
  fi
  [[ -x wfb-ng/wfb_keygen ]] || ./build.sh || die "wfb-ng isn't built: install what it lists above, then ./ipc keys again"
  if [[ -t 0 ]]; then
    say "A password gives the same keys on every PC you type it on; none gives a random pair, which you copy."
    read -rsp "Password (Enter for random): " password
    say ""
  else
    read -r password || true
  fi
  mkdir -p "$own"
  if [[ -n $password ]]; then
    (cd "$own" && ../../wfb-ng/wfb_keygen "$password" >/dev/null 2>&1)
  else
    (cd "$own" && ../../wfb-ng/wfb_keygen >/dev/null 2>&1)
  fi
  chmod 600 "$own"/*.key
  say "Your own keys are in $own/ (not in git; keep them private). Now:"
  say "  1. flash every board again: ./ipc flash camera N, ./ipc flash base"
  if [[ -n $password ]]; then
    say "  2. on any other PC that sends or receives over its own adapter: ./ipc keys, same password"
  else
    say "  2. any other PC that sends or receives over its own adapter needs a copy of $own/"
  fi
}

# The software's own tests, on this PC: the wfb-ng core, RTP/JPEG, RTSP and the web view (esp32/test.sh).
run_tests() {
  say "Checking the software on this PC (a minute or so; no boards needed)..."
  if esp32/test.sh >"$STATE/test.log" 2>&1; then
    say "All good: $(grep -oE '[0-9]+ tests? failed out of [0-9]+' "$STATE/test.log" | grep -oE '[0-9]+$') checks passed."
  else
    grep -E 'CHECK failed|Failed|\*\*\*' "$STATE/test.log" | head -20
    die "some checks failed; everything is in $STATE/test.log"
  fi
}

# First time on a PC: what flashing needs, then the extras, each saying what it's for.
setup() {
  if [[ ! -f wfb-ng/src/wifibroadcast.hpp ]]; then
    say "Fetching wfb-ng (the firmware is built from its code)..."
    git submodule update --init --depth 1 wfb-ng
  fi
  say "Installing the ESP32 tools (ESP-IDF, about 2 GB, 10-20 minutes the first time)..."
  esp32/setup.sh || die "the ESP32 tools aren't installed: install what it lists above, then run ./ipc setup again"

  say ""
  say "Extras:"
  if command -v ffmpeg >/dev/null; then
    say "  ffmpeg: there (./ipc stream)"
  else
    say "  ffmpeg: missing, needed by ./ipc stream. Install the 'ffmpeg' package."
  fi
  if ./build.sh >"$STATE/wfb-ng-build.log" 2>&1; then
    say "  wfb-ng: built (the PC-to-PC radio link, tx.sh and rx.sh)"
  else
    say "  wfb-ng: not built; only the PC-to-PC radio link (tx.sh, rx.sh) needs it. To build it:"
    sed 's/^/    /' "$STATE/wfb-ng-build.log"
  fi
  say ""
  say "Ready. Next: ./ipc flash camera 0 (or ./ipc flash base)."
}

open_url() {
  say "$1"
  if command -v xdg-open >/dev/null; then
    xdg-open "$1" >/dev/null 2>&1 || true
  fi
}

# --port PATH, anywhere in the arguments
port=""
args=()
while (($#)); do
  case $1 in
    --port) port=${2:-}; [[ -n $port ]] || die "--port needs a port, e.g. --port /dev/ttyUSB0"; shift 2 ;;
    -h|--help|help) usage; exit 0 ;;
    *) args+=("$1"); shift ;;
  esac
done
set -- "${args[@]}"
mkdir -p "$STATE"

case "${1:-} ${2:-}" in
  "flash camera") flash_camera "${3:-}" "$port" ;;
  "flash base") flash_base "$port" ;;
  "view "*) addr=$(base_address view); open_url "http://$addr/" ;;
  "stream "*)
    n=${2:-}
    [[ $n =~ ^[012]$ ]] || die "which camera? ./ipc stream 0 rtmp://server/app/cam0"
    addr=$(base_address stream "$n")
    say "Camera $n from the base station ($addr), telemetry burned in. Ctrl-C stops."
    say "  (\"NO TELEMETRY\" on the video: the base station sends it to another PC, or this PC's firewall drops it;"
    say "   ./ipc flash base sets it up for this PC.)"
    VIDEO_IN=rtsp://$addr:8554/cam$n TELEMETRY_PORT=$((5610 + n)) exec ./burnin.sh "${3:-}" ;;
  "receive "*) receive "${2:-}" ;;
  "send "*) send ;;
  "keys "*) keys "${2:-}" ;;
  "test "*) run_tests ;;
  "log "*) [[ -n $port ]] || port=$(pick_port); exec esp32/monitor.sh "$port" -t ;;
  "setup "*) setup ;;
  " ") usage ;;
  *) usage; exit 1 ;;
esac
