mainmenu "Radar camera (FRDM-RW612)"

menu "wfb-ng link"

    config LINK_CHANNEL
        int "WiFi channel"
        range 1 13
        default 6
        help
            Must match CHANNEL on the receiver (link.sh's default is 6) and the base station.

    config LINK_MCS
        int "HT20 MCS index"
        range 0 7
        default 3
        help
            The data rate. MCS 3 is 26 Mbit/s, as link.sh's MCS default.

    config LINK_ID
        hex "Link ID"
        range 0x0 0xffffff
        default 0x0
        help
            wfb-ng's link_id; with the radio port it makes the channel_id the receiver listens for.

    config LINK_RADIO_PORT
        int "Radio port (camera number)"
        range 0 15
        default 2 if LINK_PAYLOAD_RADAR_DATA || LINK_PAYLOAD_RADAR_PICTURE
        default 0
        help
            Camera N's video port; its telemetry goes on 0x10 + N. The radar is camera 2 by default, next to
            ESP32-CAMs 0 and 1 on the base station. The raw measurements go to port 0, where
            pc/radar_view.py listens.

    config LINK_FEC_K
        int "FEC k (data packets per block)"
        range 1 32
        default 1 if LINK_PAYLOAD_RADAR_DATA || LINK_PAYLOAD_RADAR_RAW
        default 8
        help
            The radar's data is one small packet per measurement: k = 1 sends each at once, as telemetry
            does. Pictures use the cameras' 8/12.

    config LINK_FEC_N
        int "FEC n (data + FEC packets per block)"
        range 1 32
        default 2 if LINK_PAYLOAD_RADAR_DATA || LINK_PAYLOAD_RADAR_RAW
        default 12

    choice LINK_PAYLOAD
        prompt "What to send"
        default LINK_PAYLOAD_RADAR_DATA

        config LINK_PAYLOAD_RADAR_DATA
            bool "What the radar finds, per measurement (and the finding as telemetry)"
            help
                Per measurement, 20 a second: the finding and the movement against distance, as a "D1"
                payload of ~124 bytes (radar_picture.hpp). The web page draws it; on a PC, radar_render
                draws it as video for ./ipc receive and the burn-in script (docs/DESIGN.md, M9).

        config LINK_PAYLOAD_RADAR_PICTURE
            bool "The radar picture (RTP/JPEG video, and the finding as telemetry)"
            help
                What the SR250 finds, drawn here as camera N's video, for receivers that only play video:
                ~1.2 Mbit/s on air at 10 pictures a second, where the data is ~40 kbit/s.

        config LINK_PAYLOAD_RADAR_RAW
            bool "The radar's raw measurements (R1, for pc/radar_view.py)"

        config LINK_PAYLOAD_COUNTER
            bool "Counter (link test)"
            help
                A numbered payload; esp32/tools/counter_check.py on the receiver reports any that go missing.

    endchoice

    config RADAR_PICTURE_EVERY
        int "Measurements per picture"
        depends on LINK_PAYLOAD_RADAR_PICTURE
        range 1 20
        default 4
        help
            The radar measures 20 times a second: 4 makes 5 pictures a second, 2 makes 10. Every
            measurement still counts for the finding and the trace. Drawing and encoding a picture takes
            ~35 ms, and each is ~10 KB, ~9 packets: 10 a second is ~1.2 Mbit/s on air with FEC. At 5 a
            second next to a camera, the base station's receive queue once overflowed: test it there.

    config RADAR_PACKET_GAP_MS
        int "Gap between a picture's packets (ms)"
        depends on LINK_PAYLOAD_RADAR_PICTURE
        range 0 50
        default 15
        help
            A picture's ~9 packets go out this far apart, ~135 ms in all, not in one burst: the base
            station passes each picture to its web viewers as it arrives, with little room per viewer.
            The next picture waits until the last packet is out, so 9 x this plus ~35 ms has to stay
            under the time between pictures (3 ms for 10 a second).

    config RADAR_JPEG_QUALITY
        int "Picture JPEG quality"
        depends on LINK_PAYLOAD_RADAR_PICTURE
        range 10 100
        default 60
        help
            60: ~8 KB a picture, the text still sharp; 80: ~11 KB.

    config LINK_COUNTER_RATE
        int "Counter payloads per second"
        depends on LINK_PAYLOAD_COUNTER
        range 1 2000
        default 100

    config LINK_COUNTER_SIZE
        int "Counter payload size (bytes)"
        depends on LINK_PAYLOAD_COUNTER
        range 32 1400
        default 400
        help
            Cut to the link's max payload if larger.

    choice RADIO_TX
        prompt "How frames reach NXP's WiFi driver"
        default RADIO_TX_COMMAND

        config RADIO_TX_COMMAND
            bool "A firmware command per frame (frames up to 1400 bytes)"

        config RADIO_TX_INJECT
            bool "wifi_inject_frame (the data path)"

    endchoice

    config RADIO_TX_CONTROL
        hex "Frame tx_control (rate) on the command path, instead of LINK_MCS"
        depends on RADIO_TX_COMMAND
        default 0x0
        help
            0: HT20 MCS LINK_MCS, i.e. bit 15 (a fixed rate) and rate index 14 + MCS from bit 16 (0-3 are
            1-11 Mbit/s, then 6-54 Mbit/s, 14-21 are MCS 0-7: measured with RADIO_RATE_SWEEP and the
            base station's received-rate report). Without a fixed rate the firmware sends at 1 Mbit/s.

    config RADIO_RATE_SWEEP
        bool "Step through the rate indexes (to find HT MCS 3)"
        depends on RADIO_TX_COMMAND
        help
            Every 4 seconds the next tx_control, bit 15 and index 0 to 31, printed on the console. The
            base station's stats line shows the rate each one gives on air.

endmenu

rsource "../components/keys/Kconfig"

source "Kconfig.zephyr"
