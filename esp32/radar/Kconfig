mainmenu "Radar camera (FRDM-RW612)"

menu "wfb-ng link"

    config LINK_CHANNEL
        int "WiFi channel"
        range 1 13
        default 6
        help
            Must match CHANNEL on the receiver (link.sh's default is 6) and the base station.

    config LINK_MCS
        int "HT20 MCS index"
        range 0 7
        default 3
        help
            The data rate. MCS 3 is 26 Mbit/s, as link.sh's MCS default.

    config LINK_ID
        hex "Link ID"
        range 0x0 0xffffff
        default 0x0
        help
            wfb-ng's link_id; with the radio port it makes the channel_id the receiver listens for.

    config LINK_RADIO_PORT
        int "Radio port (camera number)"
        range 0 15
        default 2 if LINK_PAYLOAD_RADAR_PICTURE
        default 0
        help
            Camera N's video port; its telemetry goes on 0x10 + N. The radar picture is camera 2 by default,
            next to ESP32-CAMs 0 and 1 on the base station. link.sh's wfb_rx listens on port 0.

    config LINK_FEC_K
        int "FEC k (data packets per block)"
        range 1 32
        default 1 if LINK_PAYLOAD_RADAR_RAW
        default 8
        help
            The raw radar data is one small packet per measurement: k = 1 sends each at once, as telemetry
            does. Pictures use the cameras' 8/12.

    config LINK_FEC_N
        int "FEC n (data + FEC packets per block)"
        range 1 32
        default 2 if LINK_PAYLOAD_RADAR_RAW
        default 12

    choice LINK_PAYLOAD
        prompt "What to send"
        default LINK_PAYLOAD_RADAR_PICTURE

        config LINK_PAYLOAD_RADAR_PICTURE
            bool "The radar picture (RTP/JPEG video, and the finding as telemetry)"
            help
                What the SR250 finds, drawn as camera N's video: the base station, ./ipc receive and the
                burn-in script show it as they show a camera.

        config LINK_PAYLOAD_RADAR_RAW
            bool "The radar's raw measurements (R1, for pc/radar_view.py)"

        config LINK_PAYLOAD_COUNTER
            bool "Counter (link test)"
            help
                A numbered payload; esp32/tools/counter_check.py on the receiver reports any that go missing.

    endchoice

    config RADAR_PICTURE_EVERY
        int "Measurements per picture"
        depends on LINK_PAYLOAD_RADAR_PICTURE
        range 1 20
        default 4
        help
            The radar measures 20 times a second: 4 makes 5 pictures a second.

    config RADAR_JPEG_QUALITY
        int "Picture JPEG quality"
        depends on LINK_PAYLOAD_RADAR_PICTURE
        range 10 100
        default 80

    config LINK_COUNTER_RATE
        int "Counter payloads per second"
        depends on LINK_PAYLOAD_COUNTER
        range 1 2000
        default 100

    config LINK_COUNTER_SIZE
        int "Counter payload size (bytes)"
        depends on LINK_PAYLOAD_COUNTER
        range 32 1400
        default 400
        help
            Cut to the link's max payload if larger.

    choice RADIO_TX
        prompt "How frames reach NXP's WiFi driver"
        default RADIO_TX_COMMAND

        config RADIO_TX_COMMAND
            bool "wlan_mgmtframe_tx_cfg (a command per frame, at most 512 bytes)"

        config RADIO_TX_INJECT
            bool "wifi_inject_frame (the data path)"

    endchoice

    config RADIO_TX_CONTROL
        hex "Frame tx_control (rate) on the command path, instead of LINK_MCS"
        depends on RADIO_TX_COMMAND
        default 0x0
        help
            0: HT20 MCS LINK_MCS, i.e. bit 15 (a fixed rate) and rate index 14 + MCS from bit 16 (0-3 are
            1-11 Mbit/s, then 6-54 Mbit/s, 14-21 are MCS 0-7: measured with RADIO_RATE_SWEEP and the
            base station's received-rate report). Without a fixed rate the firmware sends at 1 Mbit/s.

    config RADIO_RATE_SWEEP
        bool "Step through the rate indexes (to find HT MCS 3)"
        depends on RADIO_TX_COMMAND
        help
            Every 4 seconds the next tx_control, bit 15 and index 0 to 31, printed on the console. The
            base station's stats line shows the rate each one gives on air.

endmenu

rsource "../components/keys/Kconfig"

source "Kconfig.zephyr"
