/ {
 model = "nxp,frdm_rw612";

 aliases {
  led0 = &green_led;
  watchdog0 = &wwdt;
  usart-0 = &flexcomm3;
  i2c-0 = &flexcomm2;
  pwm-0 = &sctimer;
  sw0 = &user_button_0;
  ambient-temp0 = &p3t1755;
 };

 chosen {
  zephyr,sram = &sram_data;
  zephyr,flash = &w25q512jvfiq;
  zephyr,console = &flexcomm3;
  zephyr,shell-uart = &flexcomm3;
  zephyr,flash-controller = &ext_flash_ctrl;
  zephyr,code-partition = &slot0_partition;
  zephyr,uart-mcumgr = &flexcomm3;
 };

 leds {
  compatible = "gpio-leds";

  green_led: led_1 {
   gpios = <&hsgpio0 12 (1 << 0)>;
  };
 };

 gpio_keys {
  compatible = "gpio-keys";

  user_button_0: button_0 {
   label = "User SW2";
   gpios = <&hsgpio0 11 ((1 << 0) | (1 << 4))>;
   zephyr,code = <11>;
   status = "okay";
  };
 };

 nxp_lcd_pmod_connector: lcd-pmod-connector {
  compatible = "nxp,lcd-pmod";
  #gpio-cells = <2>;
  gpio-map-mask = <0xffffffff 0xfffffff0>;
  gpio-map-pass-thru = <0 0xf>;
  gpio-map = <10 0 &hsgpio1 12 0>,
      <12 0 &hsgpio0 18 0>;
 };

 mikrobus_header: mikrobus-connector {
  compatible = "mikro-bus";
  #gpio-cells = <2>;
  gpio-map-mask = <0xffffffff 0xffffffc0>;
  gpio-map-pass-thru = <0 0x3f>;
  gpio-map = <0 0 &hsgpio1 29 0>,
      <1 0 &hsgpio0 19 0>,
      <2 0 &hsgpio0 10 0>,
      <3 0 &hsgpio0 7 0>,
      <4 0 &hsgpio0 8 0>,
      <5 0 &hsgpio0 9 0>,
      <6 0 &hsgpio0 1 0>,
      <7 0 &hsgpio1 22 0>,
      <8 0 &hsgpio0 2 0>,
      <9 0 &hsgpio0 3 0>,
      <10 0 &hsgpio0 17 0>,
      <11 0 &hsgpio0 16 0>;
 };

 arduino_header: arduino-connector {
  compatible = "arduino-header-r3";
  #gpio-cells = <2>;
  gpio-map-mask = <0xffffffff 0xffffffc0>;
  gpio-map-pass-thru = <0 0x3f>;
  gpio-map = <0 0 &hsgpio1 10 0>,
      <1 0 &hsgpio1 11 0>,
      <2 0 &hsgpio1 13 0>,
      <6 0 &hsgpio0 9 0>,
      <7 0 &hsgpio0 8 0>,
      <8 0 &hsgpio0 11 0>,
      <9 0 &hsgpio0 15 0>,
      <10 0 &hsgpio0 18 0>,
      <11 0 &hsgpio0 27 0>,
      <12 0 &hsgpio0 0 0>,
      <13 0 &hsgpio0 20 0>,
      <14 0 &hsgpio1 18 0>,
      <15 0 &hsgpio1 20 0>,
      <16 0 &hsgpio0 6 0>,
      <17 0 &hsgpio0 9 0>,
      <18 0 &hsgpio0 8 0>,
      <19 0 &hsgpio0 7 0>,
      <20 0 &hsgpio0 16 0>,
      <21 0 &hsgpio0 17 0>;
 };
};

&flexcomm3 {
 compatible = "nxp,lpc-usart";
 status = "okay";
 current-speed = <115200>;
 pinctrl-0 = <&pinmux_flexcomm3_usart>;
 pinctrl-names = "default";
 wakeup-source;
};

&flexcomm0 {
 compatible = "nxp,lpc-usart";
 status = "disabled";
 current-speed = <115200>;
 pinctrl-0 = <&pinmux_flexcomm0_usart>;
 pinctrl-names = "default";
};

mikrobus_serial: &flexcomm0 {};

&hsgpio0 {
 status = "okay";
 pinctrl-0 = <&pinmux_hsgpio0>;
 pinctrl-names = "default";
};

&hsgpio1 {
 status = "okay";
 pinctrl-0 = <&pinmux_hsgpio1>;
 pinctrl-names = "default";
};

&flexspi {
 status = "okay";
 ahb-bufferable;
 ahb-prefetch;
 ahb-cacheable;
 ahb-read-addr-opt;
 ahb-boundary = "1024";
 rx-clock-source = <1>;
 rx-clock-source-b = <1>;


 ext_flash_ctrl: flash-controller@0 {
  compatible = "nxp,imx-flexspi-nor";
  reg = <0>;
  size = <(((64 * 8) * 1024) * 1024)>;
  status = "okay";
  jedec-id = [ef 40 20];
  spi-max-frequency = <(((104) * 1000) * 1000)>;

  #address-cells = <1>;
  #size-cells = <1>;
  ranges = <0x0 0x18000000 (((64) * 1024) * 1024)>;

  w25q512jvfiq: flash@0 {
   compatible = "soc-nv-flash";
   reg = <0x0 (((64) * 1024) * 1024)>;
   erase-block-size = <4096>;
   write-block-size = <1>;

   partitions {
    compatible = "fixed-partitions";
    #address-cells = <1>;
    #size-cells = <1>;





    boot_partition: partition@0 {
     label = "mcuboot";
     reg = <0x00000000 ((128) * 1024)>;
    };

    slot0_partition: partition@20000 {
     label = "image-0";
     reg = <0x00020000 (((3) * 1024) * 1024)>;
    };

    slot1_partition: partition@320000 {
     label = "image-1";
     reg = <0x00320000 (((3) * 1024) * 1024)>;
    };

    storage_partition: partition@620000 {
     label = "storage";
     reg = <0x00620000 ((((58) * 1024) * 1024) - ((128) * 1024))>;
    };
   };
  };
 };

 aps6404l: aps6404l@2 {
  compatible = "nxp,imx-flexspi-aps6404l";

  size = <(((8 * 8) * 1024) * 1024)>;
  reg = <2>;
  spi-max-frequency = <(((109) * 1000) * 1000)>;



  status = "disabled";
  cs-interval-unit = <1>;
  cs-interval = <2>;
  cs-hold-time = <3>;
  cs-setup-time = <3>;
  data-valid-time = <6>;
  column-space = <0>;
  ahb-write-wait-unit = <2>;
  ahb-write-wait-interval = <0>;
 };
};

&hci {
 status = "okay";
 wakeup-source;
};

&enet_mac {
 status = "okay";
 pinctrl-0 = <&pinmux_enet>;
 pinctrl-names = "default";
 phy-handle = <&phy>;
 nxp,unique-mac;
 phy-connection-type = "rmii";
};

&enet_mdio {
 status = "okay";
 pinctrl-0 = <&pinmux_mdio>;
 pinctrl-names = "default";

 phy: phy@2 {
  compatible = "microchip,ksz8081";
  reg = <2>;
  status = "okay";
  reset-gpios = <&hsgpio1 23 (1 << 0)>;
  int-gpios = <&hsgpio0 21 (0 << 0)>;
  microchip,interface-type = "rmii";
 };
};

&wwdt {
 status = "okay";
};

&dma0 {
 status = "okay";
};

&mrt0_channel0 {
 status = "okay";
};

&ctimer0 {
 status = "okay";
};

&pmu {
 reset-causes-en = <0x2>,
     <0x20>,
     <0x8>;
};


&os_timer {
 status = "okay";
 wakeup-source;
 deep-sleep-counter = <&rtc_highres>;
};

&systick {
 status = "disabled";
};

&adc0 {
 status = "okay";
};

&dac0 {
 status = "okay";
};

&sctimer {
 status = "okay";
 pinctrl-0 = <&pinmux_pwm0>;
 pinctrl-names = "default";
};


&rtc_highres {
 status = "okay";
 wakeup-source;
};

&nbu {
 status = "okay";
 wakeup-source;
};

&imu {
 status = "okay";
 wakeup-source;
};

zephyr_udc0: &usb_otg {
 status = "okay";
};







&flexcomm1 {
 compatible = "nxp,lpc-spi";
 pinctrl-0 = <&pinmux_flexcomm1_spi>;
 pinctrl-names = "default";
 status = "okay";
 #address-cells = <1>;
 #size-cells = <0>;
};

arduino_spi: &flexcomm1 {};

mikrobus_spi: &flexcomm1 {};

&flexcomm2 {
 compatible = "nxp,lpc-i2c";
 status = "okay";
 clock-frequency = <400000>;
 #address-cells = <1>;
 #size-cells = <0>;
 pinctrl-0 = <&pinmux_flexcomm2_i2c>;
 pinctrl-names = "default";

 p3t1755: p3t1755@48 {
  compatible = "nxp,p3t1755";
  reg = <0x48>;
  status = "okay";
 };
};

arduino_i2c: &flexcomm2 {};

mikrobus_i2c: &flexcomm2 {};

zephyr_mipi_dbi_spi: &lcdic {
 status = "okay";
 pinctrl-0 = <&pinmux_lcdic>;
 pinctrl-names = "default";
};

nxp_pmod_touch_panel_i2c: &arduino_i2c {
 status = "okay";
};





&idle {
 min-residency-us = <0>;
};


&suspend {
 min-residency-us = <412>;
};


&standby {
 exit-latency-us = <13460>;
 min-residency-us = <1690>;
};
