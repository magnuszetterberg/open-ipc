 pinmux_sr250_spi: pinmux_sr250_spi {
  group0 {
   pinmux = <(((6) & 0x7F) | (((0x0) & 0xF) << 7) | (((1) & 0xF) << 11) | (((3) & 0xF) << 15)) (((7) & 0x7F) | (((0x0) & 0xF) << 7) | (((1) & 0xF) << 11) | (((3) & 0xF) << 15)) (((8) & 0x7F) | (((0x0) & 0xF) << 7) | (((1) & 0xF) << 11) | (((3) & 0xF) << 15)) (((9) & 0x7F) | (((0x0) & 0xF) << 7) | (((1) & 0xF) << 11) | (((3) & 0xF) << 15))>;
   slew-rate = "ultra";
  };
 };
};

&flexcomm1 {
 pinctrl-0 = <&pinmux_sr250_spi>;



 pre-delay = <1000>;
 post-delay = <1000>;
 transfer-delay = <1000>;

 sr250: sr250@0 {
  compatible = "nxp,sr250";
  reg = <0>;

  spi-max-frequency = <1000000>;
  irq-gpios = <&hsgpio1 13 ((0 << 0) | (1 << 5))>;
  reset-gpios = <&hsgpio0 18 ((1 << 0) | (1 << 4))>;
 };
};
