/ {
 chosen {
  zephyr,entropy = &trng;
  zephyr,nbu = &nbu;
  zephyr,bt-hci = &hci;
  zephyr,hdlc-rcp-if = &hdlc_rcp_if;
 };

 cpus {
  #address-cells = <1>;
  #size-cells = <0>;

  cpu0: cpu@0 {
   compatible = "arm,cortex-m33f";
   reg = <0>;
   #address-cells = <1>;
   #size-cells = <1>;
   cpu-power-states = <&idle &suspend &standby>;

   mpu: mpu@e000ed90 {
    compatible = "arm,armv8m-mpu";
    reg = <0xe000ed90 0x40>;
   };
  };

  power-states {



   idle: idle {
    compatible = "zephyr,power-state";
    power-state-name = "runtime-idle";
    exit-latency-us = <38>;
   };


   suspend: suspend {
    compatible = "nxp,pdcfg-power", "zephyr,power-state";
    power-state-name = "suspend-to-idle";
    exit-latency-us = <38>;
    deep-sleep-config = <0x180000>,
          <0x0>,
          <0x4>,
          <0x100>,
          <0x0>;
   };


   standby: standby {
    compatible = "nxp,pdcfg-power", "zephyr,power-state";
    power-state-name = "standby";
    exit-latency-us = <4360>;
    deep-sleep-config = <0x180000>,
          <0x0>,
          <0x4>,
          <0x100>,
          <0x0>;
    status = "disabled";
   };
  };
 };

 smu1: sram@41380000 {
  ranges = <0x0 0x41380000 ((510) * 1024)>;
 };

 smu2: sram@443c0000 {
  ranges = <0x0 0x443c0000 ((140) * 1024)>;
 };

 peripheral_domain: peripheral-domain {
  compatible = "power-domain-soc-state-change";
  #power-domain-cells = <0>;
  zephyr,disabling-power-states = <&suspend &standby>;
  onoff-power-states = <&standby>;
 };

 xtal32: xtal32 {
  compatible = "fixed-clock";
  clock-frequency = <32768>;
  #clock-cells = <0>;
  status = "disabled";
 };
};

&sram {
 #address-cells = <1>;
 #size-cells = <1>;






 sram_data: memory@40000 {
  compatible = "mmio-sram";
  reg = <0x40000 ((960) * 1024)>;
 };

 sram_code: memory@0 {
  compatible = "mmio-sram";
  reg = <0x00000000 ((256) * 1024)>;
 };
};

&smu1 {
 #address-cells = <1>;
 #size-cells = <1>;

 smu1_data: memory@0 {
  compatible = "zephyr,memory-region", "mmio-sram";
  reg = <0x0 ((510) * 1024)>;
  zephyr,memory-region = "SMU1";
  zephyr,memory-attr = <(((1UL << (0))) << (20))>;
 };
};

&smu2 {
 #address-cells = <1>;
 #size-cells = <1>;

 smu2_data: memory@0 {
  compatible = "zephyr,memory-region", "mmio-sram";
  reg = <0x0 ((140) * 1024)>;
  zephyr,memory-region = "SMU2";
  zephyr,memory-attr = <(((1UL << (0))) << (20))>;
 };
};

&peripheral {
 #address-cells = <1>;
 #size-cells = <1>;

 flexspi: spi@134000 {
  reg = <0x134000 0x1000>, <0x18000000 (((128) * 1024) * 1024)>;
  reg-names = "reg_base", "ahb";
 };

 clkctl0: clkctl@1000 {

  compatible = "nxp,lpc-syscon";
  reg = <0x1000 0x1000>;
  #clock-cells = <1>;
 };

 pinctrl: mci_iomux@4000 {
  compatible = "nxp,mci-io-mux";
  reg = <0x4000 0x1000>;
  status = "okay";
 };

 clkctl1: clkctl@21000 {

  compatible = "nxp,lpc-syscon";
  reg = <0x21000 0x1000>;
  #clock-cells = <1>;
 };

 rstctl0: reset@0 {
  compatible = "nxp,rstctl";
  reg = <0x0 0x80>;
  #reset-cells = <1>;
 };

 rstctl1: reset@20000 {
  compatible = "nxp,rstctl";
  reg = <0x20000 0x80>;
  #reset-cells = <1>;
 };

 pmu: pmu@31000 {
  reg = <0x31000 0x130>;
  compatible = "nxp,rw-pmu";

  pin0: pin0 {
   compatible = "nxp,aon-wakeup-pin";
   interrupts = <100 0>;
   status = "disabled";
  };

  pin1: pin1 {
   compatible = "nxp,aon-wakeup-pin";
   interrupts = <101 0>;
   status = "disabled";
  };
 };

 trng: random@14000 {
  compatible = "nxp,kinetis-trng";
  reg = <0x14000 0x1000>;
  status = "okay";
  interrupts = <123 0>;
  power-domains = <&peripheral_domain>;
 };

 wwdt: watchdog@e000 {
  compatible = "nxp,lpc-wwdt";
  reg = <0xe000 0x1000>;
  clocks = <&clkctl0 ((0x26 << 8) | (0x00))>;
  interrupts = <0 0>;
  status = "disabled";
  power-domains = <&peripheral_domain>;
  clk-divider = <1>;
 };

 hsgpio: hsgpio@100000 {
  compatible = "nxp,lpc-gpio";
  reg = <0x100000 0x4000>;
  #address-cells = <1>;
  #size-cells = <0>;

  hsgpio0: gpio@0 {
   compatible = "nxp,lpc-gpio-port";
   gpio-controller;
   #gpio-cells = <2>;
   reg = <0>;
   int-source = "pint";
   power-domains = <&peripheral_domain>;
  };

  hsgpio1: gpio@1 {
   compatible = "nxp,lpc-gpio-port";
   gpio-controller;
   #gpio-cells = <2>;
   reg = <1>;
   int-source = "pint";
   power-domains = <&peripheral_domain>;
  };
 };

 usb_otg: usbotg@145000 {
  compatible = "nxp,ehci";
  reg = <0x145000 0x200>;
  interrupts = <50 1>;
  interrupt-names = "usb_otg";
  num-bidir-endpoints = <8>;
  power-domains = <&peripheral_domain>;
  status = "disabled";
 };

 usbh: usbh@145000 {
  compatible = "nxp,uhc-ehci";
  reg = <0x145000 0x200>;
  interrupts = <50 1>;
  interrupt-names = "usb_otg";
  power-domains = <&peripheral_domain>;
  status = "disabled";
 };

 flexcomm0: flexcomm@106000 {
  compatible = "nxp,lpc-flexcomm";
  reg = <0x106000 0x1000>;
  interrupts = <14 0>;
  clocks = <&clkctl1 ((0x01 << 8) | (0x00)) &clkctl1 ((0x01 << 8) | (0x80))>;
  clock-names = "default", "sleep";
  resets = <&rstctl1 ((0 << 16) | 8)>;
  dmas = <&dma0 0>, <&dma0 1>;
  dma-names = "rx", "tx";
  zephyr,disabling-power-states = <&suspend &standby>;
  low-power-states = <&suspend>;
  power-domains = <&peripheral_domain>;
  status = "disabled";
 };

 flexcomm1: flexcomm@107000 {
  compatible = "nxp,lpc-flexcomm";
  reg = <0x107000 0x1000>;
  interrupts = <15 0>;
  clocks = <&clkctl1 ((0x01 << 8) | (0x01)) &clkctl1 ((0x01 << 8) | (0x81))>;
  clock-names = "default", "sleep";
  resets = <&rstctl1 ((0 << 16) | 9)>;
  dmas = <&dma0 2>, <&dma0 3>;
  dma-names = "rx", "tx";
  zephyr,disabling-power-states = <&suspend &standby>;
  low-power-states = <&suspend>;
  power-domains = <&peripheral_domain>;
  status = "disabled";
 };

 flexcomm2: flexcomm@108000 {
  compatible = "nxp,lpc-flexcomm";
  reg = <0x108000 0x1000>;
  interrupts = <16 0>;
  clocks = <&clkctl1 ((0x01 << 8) | (0x02)) &clkctl1 ((0x01 << 8) | (0x82))>;
  clock-names = "default", "sleep";
  resets = <&rstctl1 ((0 << 16) | 10)>;
  dmas = <&dma0 4>, <&dma0 5>;
  dma-names = "rx", "tx";
  zephyr,disabling-power-states = <&suspend &standby>;
  low-power-states = <&suspend>;
  power-domains = <&peripheral_domain>;
  status = "disabled";
 };

 flexcomm3: flexcomm@109000 {
  compatible = "nxp,lpc-flexcomm";
  reg = <0x109000 0x1000>;
  interrupts = <17 0>;
  clocks = <&clkctl1 ((0x01 << 8) | (0x03)) &clkctl1 ((0x01 << 8) | (0x83))>;
  clock-names = "default", "sleep";
  resets = <&rstctl1 ((0 << 16) | 11)>;
  dmas = <&dma0 6>, <&dma0 7>;
  dma-names = "rx", "tx";
  zephyr,disabling-power-states = <&suspend &standby>;
  low-power-states = <&suspend>;
  power-domains = <&peripheral_domain>;
  status = "disabled";
 };

 flexcomm14: flexcomm@126000 {
  compatible = "nxp,lpc-flexcomm";
  reg = <0x126000 0x2000>;
  interrupts = <20 0>;
  clocks = <&clkctl1 ((0x01 << 8) | (0x0E))>;
  resets = <&rstctl1 ((0 << 16) | 22)>;
  dmas = <&dma0 26>, <&dma0 27>;
  dma-names = "rx", "tx";
  zephyr,disabling-power-states = <&suspend &standby>;
  power-domains = <&peripheral_domain>;
  status = "disabled";
 };

 aon_soc_ctrl: aon_soc_ctrl@5000800 {
  compatible = "nxp,rw-soc-ctrl";
  reg = <0x5000800 0x1000>;
  status = "okay";
 };

 soc_ctrl: soc_ctrl@5001000 {
  compatible = "nxp,rw-soc-ctrl";
  reg = <0x5001000 0x1000>;
  status = "okay";
 };

 pint: pint@25000 {
  compatible = "nxp,pint";
  reg = <0x25000 0x1000>;
  interrupt-controller;
  #interrupt-cells = <1>;
  #address-cells = <0>;
  interrupts = <4 2>, <5 2>, <6 2>, <7 2>,
        <35 2>, <36 2>, <37 2>, <38 2>;
  num-lines = <8>;
  num-inputs = <64>;
  power-domains = <&peripheral_domain>;
 };

 imu: nxp_wifi {
  compatible = "nxp,wifi";

  interrupts = <72 2>, <64 2>;
  power-domains = <&peripheral_domain>;
 };

 dma0: dma-controller@104000 {
  compatible = "nxp,lpc-dma";
  reg = <0x104000 0x1000>;
  interrupts = <1 0>;
  status = "disabled";
  #dma-cells = <1>;
  dma-channels = <33>;
  power-domains = <&peripheral_domain>;
 };

 lcdic: lcdic@128000 {
  compatible = "nxp,lcdic";
  reg = <0x128000 0x52>;
  interrupts = <61 0>;
  status = "disabled";
  #address-cells = <1>;
  #size-cells = <0>;
  clocks = <&clkctl1 ((0x0E << 8) | (0x00))>;
  dmas = <&dma0 0>;
  zephyr,disabling-power-states = <&suspend &standby>;
  power-domains = <&peripheral_domain>;
 };

 rtc: rtc@30000 {
  compatible = "nxp,lpc-rtc";
  reg = <0x30000 0x1000>;
  interrupts = <32 0>;
  status = "disabled";

  rtc_highres: rtc_highres {
   compatible = "nxp,lpc-rtc-highres";
   status = "disabled";
  };
 };

 ctimer0: ctimer@28000 {
  compatible = "nxp,lpc-ctimer";
  reg = <0x28000 0x1000>;
  interrupts = <10 0>;
  status = "disabled";
  clk-source = <1>;
  clocks = <&clkctl1 0>;
  mode = <0>;
  input = <0>;
  prescale = <0>;
  power-domains = <&peripheral_domain>;
 };

 ctimer1: ctimer@29000 {
  compatible = "nxp,lpc-ctimer";
  reg = <0x29000 0x1000>;
  interrupts = <11 0>;
  status = "disabled";
  clk-source = <1>;
  clocks = <&clkctl1 1>;
  mode = <0>;
  input = <0>;
  prescale = <0>;
  power-domains = <&peripheral_domain>;
 };

 ctimer2: ctimer@2a000 {
  compatible = "nxp,lpc-ctimer";
  reg = <0x2a000 0x1000>;
  interrupts = <39 0>;
  status = "disabled";
  clk-source = <1>;
  clocks = <&clkctl1 2>;
  mode = <0>;
  input = <0>;
  prescale = <0>;
  power-domains = <&peripheral_domain>;
 };

 ctimer3: ctimer@2b000 {
  compatible = "nxp,lpc-ctimer";
  reg = <0x2b000 0x1000>;
  interrupts = <13 0>;
  status = "disabled";
  clk-source = <1>;
  clocks = <&clkctl1 3>;
  mode = <0>;
  input = <0>;
  prescale = <0>;
  power-domains = <&peripheral_domain>;
 };

 sctimer: pwm@146000 {
  compatible = "nxp,sctimer-pwm";
  reg = <0x146000 0x1000>;
  interrupts = <12 0>;
  clocks = <&clkctl1 ((0x09 << 8) | (0x00))>;
  status = "disabled";
  prescaler = <8>;
  #pwm-cells = <3>;
  power-domains = <&peripheral_domain>;
 };

 mrt0: mrt@2d000 {
  compatible = "nxp,mrt";
  reg = <0x2d000 0x100>;
  interrupts = <9 0>;
  num-channels = <4>;
  num-bits = <24>;
  clocks = <&clkctl1 ((0x0B << 8) | (0x00))>;
  resets = <&rstctl1 ((2 << 16) | 8)>;
  #address-cells = <1>;
  #size-cells = <0>;
  power-domains = <&peripheral_domain>;

  mrt0_channel0: mrt0_channel@0 {
   compatible = "nxp,mrt-channel";
   reg = <0>;
   status = "disabled";
  };

  mrt0_channel1: mrt0_channel@1 {
   compatible = "nxp,mrt-channel";
   reg = <1>;
   status = "disabled";
  };

  mrt0_channel2: mrt0_channel@2 {
   compatible = "nxp,mrt-channel";
   reg = <2>;
   status = "disabled";
  };

  mrt0_channel3: mrt0_channel@3 {
   compatible = "nxp,mrt-channel";
   reg = <3>;
   status = "disabled";
  };
 };

 mrt1: mrt@3f000 {
  compatible = "nxp,mrt";
  reg = <0x3f000 0x100>;
  interrupts = <23 0>;
  num-channels = <4>;
  num-bits = <24>;
  clocks = <&clkctl1 ((0x0B << 8) | (0x01))>;
  resets = <&rstctl0 ((2 << 16) | 26)>;
  #address-cells = <1>;
  #size-cells = <0>;
  power-domains = <&peripheral_domain>;

  mrt1_channel0: mrt1_channel@0 {
   compatible = "nxp,mrt-channel";
   reg = <0>;
   status = "disabled";
  };

  mrt1_channel1: mrt1_channel@1 {
   compatible = "nxp,mrt-channel";
   reg = <1>;
   status = "disabled";
  };

  mrt1_channel2: mrt1_channel@2 {
   compatible = "nxp,mrt-channel";
   reg = <2>;
   status = "disabled";
  };

  mrt1_channel3: mrt1_channel@3 {
   compatible = "nxp,mrt-channel";
   reg = <3>;
   status = "disabled";
  };
 };

 dmic0: dmic@121000 {
  #address-cells = <1>;
  #size-cells = <0>;
  compatible = "nxp,dmic";
  reg = <0x121000 0x1000>;
  interrupts = <25 0>;
  status = "disabled";
  clocks = <&clkctl1 ((0x0A << 8) | (0x00))>;
  power-domains = <&peripheral_domain>;

  pdmc0: dmic-channel@0 {
   reg = <0>;
   dmas = <&dma0 16>;
   status = "disabled";
  };

  pdmc1: dmic-channel@1 {
   reg = <1>;
   dmas = <&dma0 17>;
   status = "disabled";
  };

  pdmc2: dmic-channel@2 {
   reg = <2>;
   dmas = <&dma0 18>;
   status = "disabled";
  };

  pdmc3: dmic-channel@3 {
   reg = <3>;
   dmas = <&dma0 19>;
   status = "disabled";
  };
 };

 gau {
  ranges;
  #address-cells = <1>;
  #size-cells = <1>;

  adc0: gau_adc0@38000 {
   compatible = "nxp,gau-adc";
   reg = <0x38000 0x100>;
   interrupts = <112 0>;
   status = "disabled";
   #io-channel-cells = <1>;
   power-domains = <&peripheral_domain>;
  };

  adc1: gau_adc1@38100 {
   compatible = "nxp,gau-adc";
   reg = <0x38100 0x100>;
   interrupts = <111 0>;
   status = "disabled";
   #io-channel-cells = <1>;
   power-domains = <&peripheral_domain>;
  };

  dac0: dac@38200 {
   compatible = "nxp,gau-dac";
   reg = <0x38200 0x30>;
   interrupts = <108 0>;
   status = "disabled";
   #io-channel-cells = <1>;
   power-domains = <&peripheral_domain>;
  };

  acomp: acomp@38400 {
   compatible = "nxp,acomp";
   reg = <0x38400 0x4c>;
   interrupts = <110 0>;
   status = "disabled";
  };
 };

 os_timer: timers@13b000 {
  compatible = "nxp,os-timer";
  reg = <0x13b000 0x1000>;
  interrupts = <41 0>;
  resets = <&rstctl1 ((0 << 16) | 27)>;
  status = "disabled";
 };

 nbu: nbu {
  compatible = "nxp,nbu";
  interrupts = <90 2>, <82 2>;
  interrupt-names = "nbu_rx_int", "wakeup_int";
 };

 hci: hci_ble {
  compatible = "nxp,hci-ble";
  power-domains = <&peripheral_domain>;
 };

 hdlc_rcp_if: hdlc_rcp_if {
  compatible = "nxp,hdlc-rcp-if";
  interrupts = <90 2>, <82 2>;
  interrupt-names = "hdlc_rcp_if_int", "wakeup_int";
  power-domains = <&peripheral_domain>;
 };

 enet: enet@138000 {
  compatible = "nxp,enet";
  reg = <0x138000 0x700>;
  clocks = <&clkctl1 ((0x0D << 8) | (0x80))>;

  enet_mac: ethernet {
   compatible = "nxp,enet-mac";
   interrupts = <115 0>;
   interrupt-names = "COMMON";
   nxp,mdio = <&enet_mdio>;
   ptp-clock = <&enet_ptp_clock>;
   status = "disabled";
   power-domains = <&peripheral_domain>;
  };

  enet_mdio: mdio {
   compatible = "nxp,enet-mdio";
   status = "disabled";
   #address-cells = <1>;
   #size-cells = <0>;
   power-domains = <&peripheral_domain>;
  };

  enet_ptp_clock: ptp-clock {
   compatible = "nxp,enet-ptp-clock";
   interrupts = <116 0>;
   status = "disabled";
   clocks = <&clkctl1 ((0x0D << 8) | (0x81))>;
   power-domains = <&peripheral_domain>;
  };
 };
};

&flexspi {
 compatible = "nxp,imx-flexspi";
 status = "disabled";
 interrupts = <42 0>;
 #address-cells = <1>;
 #size-cells = <0>;
 clocks = <&clkctl1 ((0x24 << 8) | (0x00))>;
};

&nvic {
 arm,num-irq-priority-bits = <3>;
};
