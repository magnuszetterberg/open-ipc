# 4 "/home/magnus/zephyr/zephyr-v4.4.2/zephyr/dts/arm/armv8-m.dtsi" 2 3 4

/ {
 soc {
  #address-cells = <1>;
  #size-cells = <1>;
  compatible = "simple-bus";
  interrupt-parent = <&nvic>;
  ranges;

  nvic: interrupt-controller@e000e100 {
   #address-cells = <1>;
   compatible = "arm,v8m-nvic";
   reg = <0xe000e100 0xc00>;
   interrupt-controller;
   #interrupt-cells = <2>;
  };

  systick: timer@e000e010 {
   compatible = "arm,armv8m-systick";
   reg = <0xe000e010 0x10>;
  };
 };
};
# 10 "/home/magnus/zephyr/zephyr-v4.4.2/zephyr/dts/arm/nxp/rw/nxp_rw6xx.dtsi" 2 3 4

/ {
 soc {
  sram: sram@30000000 {
   ranges = <0x20000000 0x30000000 0x130000
      0x00000000 0x10000000 0x130000>;
  };

  peripheral: peripheral@50000000 {
   ranges = <0x0 0x50000000 0x10000000>;
  };
 };
};

