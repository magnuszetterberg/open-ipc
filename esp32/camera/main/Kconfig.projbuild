menu "wfb-ng link"

    config LINK_CHANNEL
        int "WiFi channel"
        range 1 13
        default 6
        help
            Must match CHANNEL on the receiver (link.sh's default is 6).

    config LINK_MCS
        int "HT20 MCS index"
        range 0 7
        default 3
        help
            The data rate. MCS 3 is 26 Mbit/s, as link.sh's MCS default.

    config LINK_TX_POWER_DBM
        int "Transmit power (dBm)"
        range 2 20
        default 20

    config LINK_ID
        hex "Link ID"
        range 0x0 0xffffff
        default 0x0
        help
            wfb-ng's link_id; with the radio port it makes the channel_id the receiver listens for.

    config LINK_RADIO_PORT
        int "Radio port"
        range 0 255
        default 0
        help
            One per camera on a shared receiver. link.sh's wfb_rx listens on port 0.

    config LINK_TELEMETRY
        bool "Send telemetry"
        default y
        help
            Once a second, a small JSON message on its own radio port: uptime, frame rate, frame
            size, transmit power, temperature (null: the ESP32 has no supported sensor).

    config LINK_TELEMETRY_PORT
        int "Telemetry radio port"
        depends on LINK_TELEMETRY
        range 0 255
        default 16
        help
            0x10 + the camera's index (16, 17, 18), next to video on ports 0, 1, 2 (docs/DESIGN.md).

    config LINK_TELEMETRY_INTERVAL_MS
        int "Telemetry interval (ms)"
        depends on LINK_TELEMETRY
        range 100 10000
        default 1000

    config LINK_FEC_K
        int "FEC k (data packets per block)"
        range 1 32
        default 8

    config LINK_FEC_N
        int "FEC n (data + FEC packets per block)"
        range 1 32
        default 12

    choice LINK_PAYLOAD
        prompt "What to send"
        default LINK_PAYLOAD_VIDEO

        config LINK_PAYLOAD_VIDEO
            bool "Camera video (RTP/JPEG)"
            help
                Play it on the receiver with VIDEO=jpeg ./rx.sh.

        config LINK_PAYLOAD_COUNTER
            bool "Counter (link test)"
            help
                Numbered payloads instead of video, for checking the link itself:
                esp32/tools/counter_check.py on the receiver reports any that go missing.
    endchoice

    config LINK_COUNTER_RATE
        int "Counter payloads per second"
        depends on LINK_PAYLOAD_COUNTER
        range 1 1000
        default 100

    config LINK_COUNTER_SIZE
        int "Counter payload size in bytes"
        depends on LINK_PAYLOAD_COUNTER
        range 32 1448
        default 1000

endmenu

menu "Camera"
    depends on LINK_PAYLOAD_VIDEO

    choice CAMERA_FRAME_SIZE
        prompt "Frame size"
        default CAMERA_FRAME_VGA

        config CAMERA_FRAME_QVGA
            bool "320x240"
        config CAMERA_FRAME_VGA
            bool "640x480"
        config CAMERA_FRAME_SVGA
            bool "800x600"
    endchoice

    config CAMERA_CLOSE_BLOCK_PER_FRAME
        bool "Finish the FEC block at the end of each frame"
        default y
        help
            A 640x480 frame is about 7 packets, an FEC block 8. Finishing the block after each frame
            (padding it, as wfb_tx's FEC timeout does) lets the receiver recover a lost packet at once,
            instead of when the next frame completes the block 40 ms later. Costs about 14% airtime.

    config CAMERA_JPEG_QUALITY
        int "JPEG quality (lower is better and bigger)"
        range 4 63
        default 12
        help
            The OV2640's JPEG quality setting. 12 gives about 11 KB per 640x480 frame.

endmenu
