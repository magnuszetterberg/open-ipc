menu "wfb-ng link"

    config LINK_CHANNEL
        int "WiFi channel"
        range 1 13
        default 6
        help
            Must match the cameras' channel.

    config LINK_ID
        hex "Link ID"
        range 0x0 0xffffff
        default 0x0

    config BASE_CAMERAS
        int "Cameras"
        range 1 3
        default 3
        help
            Camera N (0, 1, 2) sends video on radio port N and telemetry on port 0x10 + N (docs/DESIGN.md).

    config LINK_RING_SIZE
        int "FEC blocks kept per video stream while waiting for missing packets"
        range 1 40
        default 1
        help
            Each block costs about 12 x 1.5 KB of RAM per camera. One block is enough on a radio that
            delivers in order (test_rx checks it), and it is what lets three cameras fit without PSRAM.
            wfb_rx on Linux keeps 40.

    config LINK_RX_SLOTS
        int "Received frames that can wait to be processed"
        range 4 64
        default 10
        help
            Each costs about 1.5 KB of internal RAM. Three cameras and Ethernet leave little to spare on an
            ESP32 without PSRAM (#20). A camera sends each JPEG as a burst of about 12 packets, which
            8 slots didn't always hold.

endmenu

menu "Ethernet out"

    config BASE_ETHERNET
        bool "Ethernet (Olimex ESP32-POE)"
        default y
        help
            Off: receive and report only, e.g. on an ESP32-CAM standing in as a base station for tests.
            (The ESP32-POE's Ethernet pins include GPIO16/17, which the ESP32-CAM's PSRAM uses.)

    config BASE_RTSP_PORT
        int "RTSP port"
        range 1 65535
        default 8554
        help
            Each camera plays at rtsp://<base station>:<port>/camN.

    config BASE_RTSP_CLIENTS
        int "RTSP clients at once"
        range 1 6
        default 2
        help
            Each costs its buffer (below) and about 2 KB.

    config BASE_RTSP_CLIENT_BUFFER
        int "RTSP buffer per client (bytes)"
        range 2048 16384
        default 4096
        help
            Video waiting for a client's TCP connection, on top of lwIP's own send buffer. A client that falls
            further behind loses whole RTP packets.

    config BASE_WEB
        bool "Web view"
        default y
        help
            http://<base station>/: a tile per camera with its live video (MJPEG) and telemetry (M7).

    config BASE_WEB_PORT
        int "Web view port"
        depends on BASE_WEB
        range 1 65535
        default 80

    config BASE_WEB_CLIENTS
        int "Web connections at once"
        depends on BASE_WEB
        range 1 8
        default 4
        help
            Each camera playing in a browser takes one, and the page's status requests one briefly: a page
            with three cameras needs four. A connection over the limit gets "503 too many viewers".

    config BASE_WEB_CLIENT_BUFFER
        int "Web buffer per connection (bytes)"
        depends on BASE_WEB
        range 1280 16384
        default 2048
        help
            Video waiting for a viewer's TCP connection, on top of lwIP's own send buffer. A viewer that falls
            further behind loses the rest of a frame, and gets the next one it has room for.

    config BASE_RAM_RESERVE
        int "RAM kept free for receiving (bytes)"
        range 4096 32768
        default 10240
        help
            Data for RTSP clients and web viewers is held back while sending it would leave less free RAM
            than this. TCP's buffers come from the same RAM as the radio's and Ethernet's: run dry, and every
            camera's video breaks up, not just the slow viewer's.

    config BASE_OUT_HOST
        string "Send camera 0's video and every camera's telemetry to (IPv4 address)"
        default ""
        help
            Camera 0's RTP/JPEG goes there as UDP (e.g. a PC running VIDEO=jpeg pc/receiver.sh), and each
            camera's telemetry, with the base station's signal quality added, goes to the telemetry port
            + N (pc/burnin.sh reads it; ./ipc flash base sets this PC). Empty: RTSP only.

    config BASE_OUT_PORT
        int "Video UDP port"
        range 1 65535
        default 5600
        help
            receiver.sh listens on 5600.

    config BASE_TELEMETRY_PORT
        int "Telemetry UDP port, camera 0"
        range 1 65535
        default 5610
        help
            Camera N's telemetry goes to this port + N. burnin.sh reads 5610.

endmenu
