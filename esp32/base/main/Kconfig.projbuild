menu "wfb-ng link"

    config LINK_CHANNEL
        int "WiFi channel"
        range 1 13
        default 6
        help
            Must match the cameras' channel.

    config LINK_ID
        hex "Link ID"
        range 0x0 0xffffff
        default 0x0

    config LINK_RADIO_PORT
        int "Radio port of the camera to receive"
        range 0 255
        default 0

    config LINK_RING_SIZE
        int "FEC blocks kept while waiting for missing packets"
        range 1 40
        default 4
        help
            Each block costs about 12 x 1.5 KB of RAM. wfb_rx uses 40; that won't fit here.

    config LINK_RX_SLOTS
        int "Received frames that can wait to be processed"
        range 4 64
        default 16
        help
            Each costs about 1.5 KB of internal RAM.

endmenu

menu "Ethernet out"

    config BASE_OUT_HOST
        string "Send video to (IPv4 address)"
        default ""
        help
            Where the base station sends each camera's RTP/JPEG over UDP, e.g. the NUC running
            VIDEO=jpeg ./receiver.sh. Empty: receive and report only.

    config BASE_OUT_PORT
        int "UDP port"
        range 1 65535
        default 5600
        help
            receiver.sh listens on 5600.

endmenu
