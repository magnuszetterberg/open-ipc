# Base station: any classic ESP32. No PSRAM assumed: most Ethernet ESP32 boards have none.
CONFIG_IDF_TARGET="esp32"
# The ground side of the link uses gs.key (R9)
CONFIG_WFB_KEY_FILE="keys/gs.key"
# RTSP (listener, UDP, clients), the UDP outputs and the web view (listener, clients, one to turn away)
CONFIG_LWIP_MAX_SOCKETS=16

# RAM: the base station has no PSRAM, and every KB the stack doesn't need goes to the web viewers' TCP
# buffers below. It only receives on WiFi, in promiscuous mode, and never joins a network or runs an
# access point: no AMPDU sessions, no SoftAP, no WPA3 or enterprise, fewer WiFi buffers.
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
# The LAN side: IPv4 only, no DHCP server, fewer Ethernet receive buffers (it mostly sends)
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_DHCPS=n
CONFIG_ETH_DMA_RX_BUFFER_NUM=6
# CPU: the receive task decrypts and FEC-decodes every frame (~330 a second with a camera and the radar),
# and at 160 MHz with -Og it fell behind and dropped frames. Full speed, and code built for speed.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
